node_modules/
dist/
dist-ssr/

# Local env (holds the Supabase URL + anon key). Never commit.
.env
.env.local
.env.*.local

# Editor / OS cruft
.DS_Store
*.log
.vite/
coverage/
.idea/
.vscode/

# Local git worktrees
.worktrees/

# Headless visual/perf smoke-check output (scripts/drive_game.mjs)
.playwright-output/

# Python venv for asset bake scripts
.venv/

# Downloaded CC0 3D model packs (large binaries; provenance recorded in
# art/models/LICENSES.md). Re-download from the source URLs listed there —
# both the unpacked trees and the archives they came out of.
art/models/*/
art/models/*.zip

# Downloaded CC0 source music (18-56 MB WAV/FLAC; provenance in art/LICENSES.md).
# Only the transcoded public/assets/music/ output ships — `npm run bake:music`.
art/music/

# Intermediate bake output. Only the packed atlas under public/assets/sprites/
# is committed; these are reproducible with `npm run bake:cars`.
art/build/
scripts/__pycache__/
