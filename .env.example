# Copy to .env and fill in from your Supabase project settings (API section).
# These are exposed to the browser at build time (Vite inlines VITE_* vars).
# The anon key is PUBLIC by design — all row protection is via RLS policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
